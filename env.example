# Get this from @BotFather on Telegram after creating your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceThisWithYours

# IANA timezone for scheduling the weekly Sunday summary
TIMEZONE=Asia/Singapore

# Hour (24h, local to TIMEZONE) the weekly summary is sent on Sundays
SUMMARY_HOUR=18

# Optional: path to the SQLite file. Leave unset for local dev (defaults to
# points_bot.db next to bot.py). On Railway, set this to a path on your
# mounted volume, e.g. /data/points_bot.db, so data survives redeploys.
# DB_PATH=/data/points_bot.db
